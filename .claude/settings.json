{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)"
    ]
  }
}
